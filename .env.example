PORT=3001

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=hostel_attendent
DB_PORT=3306

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=365d

# Used by the Ground Gateway ESP32 to securely send logs to this backend
GATEWAY_API_KEY=your_gateway_api_key_here

# Must be IDENTICAL to the secret flashed into every ESP32's firmware.
# Used to independently compute the same rotating BLE token as the ESP32.
BLE_TOKEN_SECRET=your_ble_token_secret_here

# How often the token rotates on the ESP32 (seconds) - must match firmware
TOKEN_ROTATION_SECONDS=45

# Minimum acceptable BLE signal strength (dBm). Weaker (more negative) = rejected.
MIN_RSSI=-100

# Rebind code validity window (minutes)
REBIND_CODE_EXPIRY_MINUTES=10

# Max rebinds allowed per student per rolling 30 days
MAX_REBINDS_PER_MONTH=2

# AES 128-bit Secret Key used for attendance payload encryption (16 characters max)
AES_SECRET_KEY=HAMS_SECRET_KEY!

# (Optional) Google Apps Script Webhook URL for external logging
# APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Firebase Admin Service Account JSON (Must be wrapped in single quotes)
FIREBASE_SERVICE_ACCOUNT_JSON='{ "type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "...", "auth_uri": "https://accounts.google.com/o/oauth2/auth", "token_uri": "https://oauth2.googleapis.com/token", "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs", "client_x509_cert_url": "...", "universe_domain": "googleapis.com" }'
